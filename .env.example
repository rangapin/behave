# copy to .env.local — never commit the real thing

# anthropic, for /api/ai (variant + critique). server-only. never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# elevenlabs, for /api/tts. server-only. optional — browser voice works without it.
ELEVENLABS_API_KEY=

# shared secret guarding both routes. any long random string.
# deliberately NEXT_PUBLIC_ — the client has to send it, so it is readable by
# anyone with devtools. that is understood and accepted: it stops crawlers and
# drive-by use of a public vercel url, and nothing more. it is not auth.
# see specs.md §3 "route guard".
NEXT_PUBLIC_SURFACE_SECRET=
